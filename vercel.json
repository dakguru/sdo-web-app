{
  "rewrites": [
    { "source": "/login", "destination": "/Leave Orders/login.html" },
    { "source": "/", "destination": "/Leave Orders/homepage.html" },
    { "source": "/ir-builder", "destination": "/app/wwwroot/index.html" },
    { "source": "/leave-orders", "destination": "/Leave Orders/index.html" },
    { "source": "/arrangements", "destination": "/Leave Orders/arrangements.html" },
    { "source": "/employees", "destination": "/Leave Orders/employees.html" },
    { "source": "/office-management", "destination": "/Leave Orders/office-management.html" },
    { "source": "/birthdays", "destination": "/Leave Orders/birthdays.html" },
    { "source": "/retirements", "destination": "/Leave Orders/retirements.html" },
    { "source": "/sanctioned-posts", "destination": "/Leave Orders/sanctioned-posts.html" },
    { "source": "/auth-guard.js", "destination": "/Leave Orders/auth-guard.js" },
    { "source": "/leave-orders/(.*)", "destination": "/Leave Orders/$1" },
    { "source": "/data/(.*)", "destination": "/app/data/$1" },
    { "source": "/templates/(.*)", "destination": "/templates/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/app/wwwroot/$1" }
  ]
}
