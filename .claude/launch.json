{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ir",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "app/Start-Server.ps1"],
      "autoPort": true
    },
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", ".", "-p", "8099", "-c-1", "--silent"],
      "port": 8099
    }
  ]
}
